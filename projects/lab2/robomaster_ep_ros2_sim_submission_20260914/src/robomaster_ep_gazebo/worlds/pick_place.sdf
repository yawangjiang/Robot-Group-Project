<?xml version="1.0"?>
<sdf version="1.8">
  <world name="robomaster_world">
    <!-- Bright neutral lighting prevents untextured URDF and SDF visuals from
         collapsing to black on the Jetson / Ogre2 renderer. -->
    <scene>
      <ambient>0.68 0.72 0.80 1</ambient>
      <background>0.36 0.56 0.80 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="stable_1khz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.98 0.96 0.91 1</diffuse>
      <specular>0.30 0.30 0.30 1</specular>
      <direction>-0.45 0.25 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="fill_light" type="point">
      <pose>0.2 -1.2 1.8 0 0 0</pose>
      <diffuse>0.55 0.68 0.90 1</diffuse>
      <specular>0.12 0.15 0.20 1</specular>
      <attenuation><range>5</range><constant>0.7</constant><linear>0.12</linear><quadratic>0.02</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.02 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4 4 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor">
          <geometry><box><size>4 4 0.04</size></box></geometry>
          <material><ambient>0.70 0.75 0.82 1</ambient><diffuse>0.78 0.82 0.88 1</diffuse><specular>0.12 0.14 0.18 1</specular></material>
        </visual>
        <!-- Simple axes give scale and orientation without texture dependencies. -->
        <visual name="x_axis"><pose>0 0 0.021 0 0 0</pose><geometry><box><size>2.4 0.012 0.002</size></box></geometry><material><ambient>0.10 0.42 0.90 1</ambient><diffuse>0.10 0.42 0.90 1</diffuse><emissive>0.02 0.08 0.18 1</emissive></material></visual>
        <visual name="y_axis"><pose>0 0 0.021 0 0 0</pose><geometry><box><size>0.012 2.4 0.002</size></box></geometry><material><ambient>0.96 0.42 0.05 1</ambient><diffuse>0.96 0.42 0.05 1</diffuse><emissive>0.16 0.05 0.01 1</emissive></material></visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision"><pose>0.40 0 0.19 0 0 0</pose><geometry><box><size>0.38 0.45 0.04</size></box></geometry></collision>
        <visual name="top"><pose>0.40 0 0.19 0 0 0</pose><geometry><box><size>0.38 0.45 0.04</size></box></geometry><material><ambient>0.025 0.25 0.62 1</ambient><diffuse>0.035 0.40 0.92 1</diffuse><specular>0.38 0.48 0.68 1</specular></material></visual>
        <visual name="front_edge"><pose>0.202 0 0.19 0 0 0</pose><geometry><box><size>0.018 0.46 0.055</size></box></geometry><material><ambient>0.00 0.78 0.92 1</ambient><diffuse>0.00 0.82 0.96 1</diffuse><emissive>0.00 0.10 0.13 1</emissive></material></visual>
        <collision name="left_leg_collision"><pose>0.40 0.175 0.085 0 0 0</pose><geometry><box><size>0.055 0.055 0.17</size></box></geometry></collision>
        <collision name="right_leg_collision"><pose>0.40 -0.175 0.085 0 0 0</pose><geometry><box><size>0.055 0.055 0.17</size></box></geometry></collision>
        <visual name="left_leg"><pose>0.40 0.175 0.085 0 0 0</pose><geometry><box><size>0.055 0.055 0.17</size></box></geometry><material><ambient>0.06 0.10 0.19 1</ambient><diffuse>0.09 0.16 0.28 1</diffuse><specular>0.25 0.28 0.34 1</specular></material></visual>
        <visual name="right_leg"><pose>0.40 -0.175 0.085 0 0 0</pose><geometry><box><size>0.055 0.055 0.17</size></box></geometry><material><ambient>0.06 0.10 0.19 1</ambient><diffuse>0.09 0.16 0.28 1</diffuse><specular>0.25 0.28 0.34 1</specular></material></visual>
      </link>
    </model>

    <model name="pick_cube">
      <pose>0.350 0 0.245 0 0 0</pose>
      <!-- This demo uses SetEntityPose for deterministic attachment.  Keep the
           showcased cube kinematic and visual-only so pose updates cannot
           accumulate collision impulses or launch it through the scene. -->
      <static>true</static>
      <link name="link">
        <visual name="orange_cube"><geometry><box><size>0.03 0.03 0.03</size></box></geometry><material><ambient>1.00 0.18 0.01 1</ambient><diffuse>1.00 0.34 0.015 1</diffuse><specular>0.75 0.42 0.12 1</specular><emissive>0.12 0.018 0 1</emissive></material></visual>
        <visual name="cube_marker"><pose>0 0 0.0155 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.0015</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.12 0.12 0.12 1</emissive></material></visual>
      </link>
    </model>

    <!-- Slotted stations: 50 mm of support in X keeps the 30 mm cube level,
         while the 18 mm Y width leaves clearance for the opposing fingers. -->
    <model name="pickup_station">
      <static>true</static>
      <pose>0.350 0 0.211 0 0 0</pose>
      <link name="link">
        <visual name="pickup_ring"><geometry><cylinder><radius>0.036</radius><length>0.002</length></cylinder></geometry><material><ambient>0.00 0.34 0.48 1</ambient><diffuse>0.00 0.72 0.96 1</diffuse><emissive>0.00 0.16 0.24 1</emissive></material></visual>
        <collision name="pickup_pad_collision"><pose>0 0 0.009 0 0 0</pose><geometry><box><size>0.050 0.018 0.020</size></box></geometry></collision>
        <visual name="pickup_pad"><pose>0 0 0.009 0 0 0</pose><geometry><box><size>0.050 0.018 0.020</size></box></geometry><material><ambient>0.02 0.28 0.42 1</ambient><diffuse>0.02 0.62 0.86 1</diffuse><specular>0.25 0.50 0.62 1</specular></material></visual>
      </link>
    </model>

    <model name="place_station">
      <static>true</static>
      <pose>0.540 0 0.211 0 0 0</pose>
      <link name="link">
        <visual name="target_outer"><geometry><cylinder><radius>0.036</radius><length>0.002</length></cylinder></geometry><material><ambient>0.01 0.20 0.05 1</ambient><diffuse>0.01 0.28 0.07 1</diffuse><emissive>0.00 0.05 0.01 1</emissive></material></visual>
        <visual name="target_inner"><pose>0 0 0.0015 0 0 0</pose><geometry><cylinder><radius>0.027</radius><length>0.002</length></cylinder></geometry><material><ambient>0.02 1.00 0.16 1</ambient><diffuse>0.02 1.00 0.16 1</diffuse><emissive>0.01 0.28 0.04 1</emissive></material></visual>
        <collision name="place_pad_collision"><pose>0 0 0.009 0 0 0</pose><geometry><box><size>0.050 0.018 0.020</size></box></geometry></collision>
        <visual name="place_pad"><pose>0 0 0.009 0 0 0</pose><geometry><box><size>0.050 0.018 0.020</size></box></geometry><material><ambient>0.03 0.30 0.08 1</ambient><diffuse>0.04 0.74 0.13 1</diffuse><specular>0.24 0.48 0.22 1</specular></material></visual>
      </link>
    </model>
  </world>
</sdf>
