<?xml version="1.0"?>
<robot name="robomaster_ep_core">
  <group name="arm"><chain base_link="arm_mount_link" tip_link="tool0"/></group>
  <group name="gripper"><joint name="left_finger_joint"/><joint name="right_finger_joint"/></group>
  <group_state name="home" group="arm"><joint name="shoulder_joint" value="-0.35"/><joint name="elbow_joint" value="0.70"/></group_state>
  <group_state name="open" group="gripper"><joint name="left_finger_joint" value="0.041"/><joint name="right_finger_joint" value="-0.041"/></group_state>
  <group_state name="closed" group="gripper"><joint name="left_finger_joint" value="0.006"/><joint name="right_finger_joint" value="-0.006"/></group_state>
  <end_effector name="end_effector" parent_link="tool0" group="gripper" parent_group="arm"/>
  <disable_collisions link1="base_link" link2="arm_mount_link" reason="Adjacent"/>
  <disable_collisions link1="arm_mount_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
</robot>
